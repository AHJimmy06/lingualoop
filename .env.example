# Copy to .env (ignored by Git), then set the DB password file path created locally.
PORT=5000
LINGUALOOP_DB_HOST=127.0.0.1
LINGUALOOP_DB_PORT=5544
LINGUALOOP_DB_PASSWORD_FILE=C:/Users/<you>/AppData/Local/LinguaLoop/secrets/postgres-password
LINGUALOOP_TOKEN_SIGNING_KEY=<generate-a-private-random-32-byte-or-longer-value>
LINGUALOOP_WEB_ORIGIN=http://localhost:5001

# Local NVIDIA NeMo-Speech.cpp server. API starts/stops it with the API process.
LINGUALOOP_STT_ENABLED=true
LINGUALOOP_STT_SERVER_URL=http://127.0.0.1:8080
LINGUALOOP_STT_PORT=8080
LINGUALOOP_STT_MODEL=nemotron-3.5
LINGUALOOP_STT_EXECUTABLE=C:/Users/<you>/AppData/Local/Programs/NeMoSpeech/bin/nemo-speech.exe
LANGUAGE_PRACTICE_FFMPEG_PATH=C:/path/to/ffmpeg.exe

# Local Piper voices. API starts them on boot; synthesis is performed on a TTS request.
LANGUAGE_PRACTICE_PIPER_PATH=C:/Users/<you>/AppData/Local/Programs/Piper/piper/piper.exe
LANGUAGE_PRACTICE_PIPER_MODEL_EN=C:/Users/<you>/AppData/Local/LinguaLoop/models/piper/en.onnx
LANGUAGE_PRACTICE_PIPER_MODEL_ES=C:/Users/<you>/AppData/Local/LinguaLoop/models/piper/es.onnx
LINGUALOOP_PIPER_MODEL_EN_SHA256=<sha256>
LINGUALOOP_PIPER_SIDECAR_EN_SHA256=<sha256>
LINGUALOOP_PIPER_MODEL_ES_SHA256=<sha256>
LINGUALOOP_PIPER_SIDECAR_ES_SHA256=<sha256>

# OpenAI coach is opt-in. Never set true unless you intend to send a practice turn to OpenAI.
LINGUALOOP_OPENAI_COACH_ENABLED=false
OPENAI_API_KEY=
LANGUAGE_PRACTICE_OPENAI_MODEL=gpt-6-luna
